{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AiChiHongShu",
  "version": "0.1.3",
  "identifier": "com.aichihongshu.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1422",
    "beforeBuildCommand": "pnpm build:tauri",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "爱吃红薯（AI吃红书）",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "../../app",
      "../../crawler",
      "../../tools/MediaCrawler/base",
      "../../tools/MediaCrawler/cmd_arg",
      "../../tools/MediaCrawler/config",
      "../../tools/MediaCrawler/constant",
      "../../tools/MediaCrawler/libs",
      "../../tools/MediaCrawler/media_platform",
      "../../tools/MediaCrawler/model",
      "../../tools/MediaCrawler/store",
      "../../tools/MediaCrawler/main.py",
      "../../tools/MediaCrawler/var.py",
      "../../pyproject.toml",
      "../../uv.lock",
      "../../.env.example",
      "../../tools/MediaCrawler/pyproject.toml",
      "../../tools/MediaCrawler/uv.lock"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "wix": {
        "language": "zh-CN"
      }
    }
  }
}
