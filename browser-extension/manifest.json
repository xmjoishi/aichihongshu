{
  "manifest_version": 3,
  "name": "爱吃红薯数据抓取",
  "version": "0.3.5",
  "description": "识别当前页归属后，收藏素材或记录数据快照（本地 Native Messaging）",
  "key": "",
  "permissions": ["nativeMessaging", "scripting", "activeTab"],
  "host_permissions": [],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_title": "数据抓取（当前页）",
    "default_popup": "popup.html"
  }
}
